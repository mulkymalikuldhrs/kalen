# ══════════════════════════════════════════════════════════════════
# KALEN — Kinetic Autonomous Layer for Entity Networking
# Environment Variables Template
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit real secrets to version control.
# ══════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────
NODE_ENV=development
KALEN_APP_NAME=KALEN
KALEN_APP_URL=http://localhost:3000
KALEN_API_URL=http://localhost:3001

# ─── Authentication / JWT ────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-secure-random-string-at-least-48-chars
JWT_ISSUER=kalen
JWT_AUDIENCE=kalen-api

# ─── WebAuthn / Passkeys ─────────────────────────────────────────
WEBAUTHN_RP_NAME=KALEN
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ─── Database (PostgreSQL) ───────────────────────────────────────
DATABASE_URL=postgresql://kalen:kalen_dev@localhost:5432/kalen
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kalen
DATABASE_USER=kalen
DATABASE_PASSWORD=kalen_dev

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── NATS ─────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=kalen-cluster

# ─── MinIO / Object Storage ──────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kalen-uploads
MINIO_USE_SSL=false

# ─── Elasticsearch ───────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=kalen

# ─── LiveKit (WebRTC) ───────────────────────────────────────────
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ─── MCP Gateway ─────────────────────────────────────────────────
MCP_GATEWAY_PORT=3004
MCP_MAX_CONCURRENT_CALLS=10
MCP_TOOL_CALL_TIMEOUT=30000
MCP_CONNECTION_TIMEOUT=10000
MCP_RBAC_ENABLED=true

# ─── A2A Router ──────────────────────────────────────────────────
A2A_ROUTER_PORT=3005
A2A_DISCOVERY_CACHE_TTL=300
A2A_MAX_TASKS_PER_AGENT=100
A2A_TASK_TIMEOUT=300000

# ─── Monitoring ──────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_URL=http://localhost:3100

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
