# ═══════════════════════════════════════════════════════════════
# KALEN — Environment Variable Template
# Copy this file to .env and fill in the values before starting.
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to version control.
# ⚠️  All "required" variables MUST be set with cryptographically
#     random values in staging/production.
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
# Application port
PORT=4000
# Environment: development | staging | production
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kalen
DATABASE_USER=kalen
# Required — generate with: openssl rand -base64 32
DATABASE_PASSWORD=kalen_dev

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Required in production — generate with: openssl rand -base64 32
REDIS_PASSWORD=kalen_dev

# ── JWT ────────────────────────────────────────────────────────
# Required — generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64
# Access token time-to-live
JWT_EXPIRES_IN=24h
# Refresh token time-to-live
JWT_REFRESH_EXPIRES_IN=7d
# Token issuer claim
JWT_ISSUER=kalen

# ── WebAuthn (Passkey Authentication) ─────────────────────────
# Display name shown in browser passkey dialog
WEBAUTHN_RP_NAME=KALEN
# Relying Party ID — must match your domain (e.g., kalen.example.com in prod)
WEBAUTHN_RP_ID=localhost
# Relying Party origin — must include scheme (https:// in prod)
WEBAUTHN_ORIGIN=http://localhost:3000

# ── OpenIM (Instant Messaging) ────────────────────────────────
OPENIM_API_URL=http://localhost:10002
# Required if OpenIM integration is enabled
OPENIM_SECRET=

# ── LiveKit (WebRTC SFU) ──────────────────────────────────────
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ── MCP Gateway (Model Context Protocol) ──────────────────────
# Default timeout for MCP tool invocations (milliseconds)
MCP_DEFAULT_TIMEOUT=30000
# Maximum concurrent MCP tool calls across all agents
MCP_MAX_CONCURRENT_CALLS=50

# ── A2A Router (Agent-to-Agent Protocol) ──────────────────────
# Maximum concurrent tasks a single agent can handle
A2A_MAX_TASKS_PER_AGENT=1000

# ── MinIO (S3-Compatible Object Storage) ──────────────────────
MINIO_ENDPOINT=localhost
MINIO_ACCESS_KEY=kalen_dev
MINIO_SECRET_KEY=kalen_dev_secret
# Enable SSL for MinIO connections (true if not on the same Docker network)
MINIO_USE_SSL=false

# ── NATS (Event Bus with JetStream) ──────────────────────────
NATS_URL=nats://localhost:4222

# ── Elasticsearch (Full-Text Search) ──────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200

# ── Coturn (TURN Server) ──────────────────────────────────────
TURN_URL=turn:localhost:3478
TURN_USERNAME=kalen
TURN_PASSWORD=change-me-turn-secret
TURN_SECRET=change-me-turn-shared-secret

# ── Monitoring ─────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin
LOKI_PORT=3100
PROMETHEUS_PORT=9090

# ── Agent Identity ─────────────────────────────────────────────
# Always true in production — enforces (ai) suffix for agent names
AGENT_SUFFIX_REQUIRED=true

# ── LLM / AI ──────────────────────────────────────────────────
# Provider: ollama | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:70b
LLM_BASE_URL=http://localhost:11434
# Optional — required for cloud LLM providers
LLM_API_KEY=
