# ─── Application ────────────────────────────────────────
NODE_ENV=development
APP_PORT=4000

# ─── Database (PostgreSQL) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kalen
DB_PASSWORD=kalen_dev_password
DB_DATABASE=kalen
DB_SYNCHRONIZE=true

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars!!

# ─── WebAuthn ──────────────────────────────────────────
WEBAUTHN_RP_NAME=KALEN
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── OpenIM ─────────────────────────────────────────────
OPENIM_API_URL=http://localhost:10002
OPENIM_SECRET=openim_secret_key

# ─── MCP Gateway ───────────────────────────────────────
MCP_MAX_CONCURRENT_CALLS=10
MCP_DEFAULT_TIMEOUT=30000

# ─── A2A Router ────────────────────────────────────────
A2A_MAX_TASKS_PER_AGENT=100
A2A_TASK_TIMEOUT=300000
