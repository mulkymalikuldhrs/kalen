    "test": "jest --config jest.config.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "jest": "^30.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^30.0.0"
  }
}
